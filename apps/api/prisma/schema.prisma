  DELIVERED
  NO_ANSWER
  CALL_BACK
  POSTPONED
  WRONG_NUMBER
  CANCELLED
  REFUSED
  RETURNED
}

/// Provenance d'une commande.
///
/// POURQUOI DES VALEURS PAR PLATEFORME, ET NON UN SEUL « WEBSITE »
///   Un commercant qui tient deux boutiques en ligne et deux comptes
///   publicitaires ne demande pas « combien de commandes viennent du web ? »
///   mais « laquelle des deux convertit ? ». Fondre Shopify, WooCommerce,
///   Youcan et Lightfunnels dans `WEBSITE` — et Facebook et TikTok dans
///   `SOCIAL` — rend cette question sans reponse, alors que l'attribution par
///   canal est le chiffre le plus regarde du commerce en paiement a la
///   livraison.
///
/// `ABANDONED_CART` N'EST PAS UNE PLATEFORME
///   C'est une NATURE de commande : un panier non finalise, relance par la
///   boutique. Elle change le script d'appel — on ne parle pas a quelqu'un qui
///   a commande comme a quelqu'un qui a renonce — et ouvre un taux de
///   recuperation qu'aucune autre valeur ne permettait de calculer.
///
/// LES VALEURS GENERIQUES RESTENT
///   `WEBSITE`, `SOCIAL`, `API` et `CSV_IMPORT` couvrent ce qui n'est pas
///   nomme ici. Les retirer obligerait a inventer une plateforme pour chaque
///   provenance inconnue.
enum OrderSource {
  GOOGLE_SHEETS
  MANUAL
  CSV_IMPORT
  EXCEL_IMPORT
  API
  WEBSITE
  SOCIAL

  // --- Paniers abandonnes ---
  ABANDONED_CART

  // --- Plateformes de vente ---
  SHOPIFY
  WOOCOMMERCE
  YOUCAN
  LIGHTFUNNELS

  // --- Canaux publicitaires ---
  FACEBOOK
  TIKTOK
}

enum ActorKind {
  USER
  SYSTEM
}

enum ConfirmationChannel {
  WHATSAPP_AUTO
  HUMAN_AGENT
  NOT_APPLICABLE
}

enum WhatsappFilterState {
  NOT_ELIGIBLE
  PENDING
  SENT
  CONFIRMED
  MODIFICATION_REQUESTED
  CANCELLED_BY_CUSTOMER
  NO_RESPONSE
  FAILED
  HANDED_OVER
}

/// Mode de livraison convenu avec le client.
///
/// Les deux valeurs reprennent MOT POUR MOT celles de l'interface
/// transporteur (`CarrierAdapter.deliveryType`), pour qu'aucune table de
/// correspondance ne s'intercale entre ce que l'agent choisit au telephone et
/// ce qui part chez Yalidine ou Noest. `PICKUP_POINT` est le « stopdesk » des
/// transporteurs algeriens : le client retire son colis au bureau.
enum DeliveryType {
  HOME
  PICKUP_POINT
}

/// Que faire quand une variante n'a plus de stock disponible.
///
/// `INHERIT` est la valeur par defaut, et c'est deliberé : le comportement de
/// rupture existait deja au niveau de la BOUTIQUE (`TenantSettings.allowOversell`,
/// desactive par defaut). Faire porter aux variantes existantes une valeur
/// propre reviendrait a autoriser silencieusement la survente sur tout le
/// catalogue le jour de la migration. La variante ne decide que lorsqu'elle a
/// une raison de deroger.
enum OutOfStockBehavior {
  /// Suit le reglage de la boutique.
  INHERIT
  /// Vend malgre la rupture (precommande assumee).
  ALLOW
  /// Refuse des la CREATION de la commande : la ligne n'entre pas.
  REFUSE_ORDER
  /// Accepte la commande, refuse sa CONFIRMATION tant que le stock manque.
  REFUSE_CONFIRMATION
}

/// Ordre de consommation des lots de stock a la sortie.
///
/// N'a d'effet que pour les variantes suivies par lots (`StockBatch`). Une
/// variante sans lot sort de `InventoryLevel` comme avant.
enum StockExitStrategy {
  /// Premier entre, premier sorti.
  FIFO
  /// Dernier entre, premier sorti.
  LIFO
  /// Peremption la plus proche d'abord. Sans date, se rabat sur FIFO.
  FEFO
  RANDOM
}

/// Nature du compte transporteur.
///
/// Change le REPORTING, pas le protocole : un agent de livraison independant
/// et une societe de livraison ne se pilotent pas de la meme facon, et melanger
/// les deux dans un meme total rend le chiffre inexploitable.
enum CarrierAccountKind {
  /// Livreur independant, souvent paye a la course.
  DELIVERY_AGENT
  /// Societe de livraison sous contrat.
  DELIVERY_COMPANY
}

enum CallOutcome {
  CONFIRMED
  NO_ANSWER
  CALL_BACK
  POSTPONED
  CANCELLED
  // Le CLIENT a refuse la commande au telephone. Distinct de CANCELLED, ou
  // c'est la boutique qui renonce : les deux ne disent pas la meme chose du
  // client, et le score de fiabilite les compte differemment.
  REFUSED
  WRONG_NUMBER
  BUSY
  OTHER
}

enum InventoryMovementType {
  INBOUND
  RESERVATION
  RESERVATION_RELEASE
  OUTBOUND
  RETURN_RESTOCK
  RETURN_QUARANTINE
  ADJUSTMENT
  /// Annulation d'une sortie : la marchandise n'est jamais partie.
  ///
  /// A NE PAS CONFONDRE AVEC UN RETOUR. `RETURN_RESTOCK` decrit une
  /// marchandise qui est allee chez le client et qui revient — elle a voyage,
  /// elle peut etre abimee, et le taux de retour la compte. Celui-ci decrit une
  /// expedition ANNULEE avant d'avoir eu lieu : le colis n'a pas bouge, et le
  /// compter comme un retour fausserait l'indicateur le plus surveille du
  /// paiement a la livraison.
  OUTBOUND_REVERSAL
}

enum InventoryReferenceType {
  ORDER
  RETURN
  MANUAL
  IMPORT
  SHIPMENT
}

enum ShipmentStatus {
  DRAFT
  CREATION_PENDING
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
