// ============================================================================
// EcomFlow — Schema de base de donnees
// ----------------------------------------------------------------------------
// Source de verite : V2 §27 (entites principales), V1 §25, Addendum §31-§39.
//
// PRINCIPES STRUCTURANTS
//
// 1. MULTI-TENANT
//    Toute entite metier porte `tenantId`. Le filtrage est applique a trois
//    niveaux independants :
//      a. l'extension Prisma `tenantGuard` (apps/api/src/infra/prisma) qui
//         injecte le filtre et refuse toute requete non scopee ;
//      b. les services, qui ne recoivent jamais un tenantId depuis le body ;
//      c. la contrainte d'integrite : les cles etrangeres inter-entites sont
//         doublees d'un index composite `(tenantId, id)` la ou une jointure
//         croisee serait possible.
//
// 2. MONNAIE
//    Tous les montants sont des ENTIERS de centimes de dinar (`Int`), jamais
//    des flottants. Voir packages/shared/src/money.ts.
//
// 3. HISTORIQUE
//    Aucune donnee metier importante n'est ecrasee : les changements de statut,
//    les tentatives d'appel, les evenements transporteur et les mouvements de
//    stock sont append-only. Les suppressions sont logiques (`archivedAt`).
//
// 4. IDEMPOTENCE
//    Chaque source externe possede une contrainte UNIQUE qui rend la
//    re-synchronisation inoffensive (voir SheetRowImport, IdempotencyKey,
//    ProcessedWebhook, Shipment.orderId).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

