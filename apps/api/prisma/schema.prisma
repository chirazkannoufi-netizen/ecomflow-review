  ONBOARDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
  LOCKED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RoleScope {
  PLATFORM
  TENANT
}

