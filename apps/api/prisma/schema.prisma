// ============================================================================
// PLATEFORME : identites, tenants, RBAC
// ============================================================================

/// Compte utilisateur global. Un utilisateur peut appartenir a plusieurs
/// boutiques via `Membership` (V1 §25 : « evolution future vers plusieurs
/// boutiques par compte »). L'identite est donc separee du tenant des le depart.
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique
  /// Hash Argon2id. Null uniquement pour un compte cree via OAuth Google.
  passwordHash      String?    @map("password_hash")
  fullName          String     @map("full_name")
  /// Telephone normalise E.164, verifie par OTP. Cle anti-abus du Trial
  /// (Addendum §38) : unique au niveau plateforme lorsqu'il est verifie.
  phoneE164         String?    @map("phone_e164")
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status            UserStatus @default(PENDING_VERIFICATION)
  /// Compteur de tentatives de connexion echouees consecutives.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  googleSubject     String?    @unique @map("google_subject")
  locale            String     @default("fr")
  timezone          String     @default("Africa/Algiers")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Anonymisation RGPD/loi 18-07 : la ligne est conservee pour l'integrite
  /// referentielle mais videe de ses donnees personnelles.
  anonymizedAt      DateTime?  @map("anonymized_at") @db.Timestamptz(3)

  memberships        Membership[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  otpChallenges      OtpChallenge[]
  auditLogs          AuditLog[]
  platformRoleLinks  PlatformRoleAssignment[]
  ownedTenants       Tenant[]                 @relation("TenantCreatedBy")

  @@index([phoneE164])
  @@index([status])
  @@map("users")
}

/// Boutique. Unite d'isolation de toutes les donnees metier.
model Tenant {
  id                  String       @id @default(uuid(7)) @db.Uuid
  name                String
  slug                String       @unique
  status              TenantStatus @default(ONBOARDING)
  logoUrl             String?      @map("logo_url")
  /// Fuseau utilise pour les bornes de periode du dashboard et les jobs.
  timezone            String       @default("Africa/Algiers")
  currency            String       @default("DZD")
  createdByUserId     String?      @map("created_by_user_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt         DateTime?    @map("suspended_at") @db.Timestamptz(3)
  closedAt            DateTime?    @map("closed_at") @db.Timestamptz(3)
  /// Date au-dela de laquelle les donnees personnelles seront anonymisees
  /// si aucun abonnement n'est souscrit (Addendum §37).
  dataRetentionUntil  DateTime?    @map("data_retention_until") @db.Timestamptz(3)

  createdBy User? @relation("TenantCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  settings            TenantSettings?
  subscription        Subscription?
  onboarding          OnboardingProgress?
  memberships         Membership[]
  roles               Role[]
  customers           Customer[]
  addresses           Address[]
  categories          ProductCategory[]
  products            Product[]
  variants            ProductVariant[]
  inventoryLevels     InventoryLevel[]
  inventoryMovements  InventoryMovement[]
  stockBatches        StockBatch[]
  productCrossSells   ProductCrossSell[]
  deliveryFees        TenantDeliveryFee[]
  productDeliveryFeeOverrides ProductDeliveryFeeOverride[]
  orders              Order[]
  orderItems          OrderItem[]
  orderStatusHistory  OrderStatusHistory[]
  callAttempts        OrderCallAttempt[]
  duplicateFlags      OrderDuplicateFlag[]
  shipments           Shipment[]
  shipmentEvents      ShipmentEvent[]
  carrierAccounts     CarrierAccount[]
  returns             Return[]
  returnItems         ReturnItem[]
  integrations        Integration[]
  sheetConfigs        SheetSyncConfig[]
  sheetRowImports     SheetRowImport[]
  syncRuns            SyncRun[]
  importJobs          ImportJob[]
  exportJobs          ExportJob[]
  idempotencyKeys     IdempotencyKey[]
  payments            Payment[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  auditLogs           AuditLog[]
  orderSequences      OrderSequence[]
  whatsappThreads     WhatsappThread[]
  trialRegistration   TrialRegistration?
  outboxEvents        OutboxEvent[]
  incidents           Incident[]

  @@index([status])
  @@map("tenants")
}

/// Parametres operationnels d'une boutique. Table separee du tenant pour
/// eviter de charger une ligne large sur chaque requete authentifiee.
model TenantSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// Langue par defaut de l'interface pour les nouveaux membres de la boutique.
  /// Un utilisateur garde toujours la main : `User.locale` prime.
  defaultLocale String @default("fr") @map("default_locale")

  /// Langue imposee aux messages adresses aux CLIENTS FINAUX.
  /// `null` = suivre la langue connue de chaque client (comportement par
  /// defaut, et le meilleur : on ecrit a chacun dans sa langue).
  customerMessageLocale String? @map("customer_message_locale")

  /// Seuil d'alerte de stock par defaut, surchageable par variante.
  lowStockThreshold Int @default(5) @map("low_stock_threshold")

  /// Reserve le stock des la confirmation (true) ou seulement a la preparation.
  reserveStockOnConfirm Boolean @default(true) @map("reserve_stock_on_confirm")

  /// Autorise la confirmation d'une commande dont le stock est insuffisant.
  /// Desactive par defaut : l'integrite du stock prime (prompt §60).
  allowOversell Boolean @default(false) @map("allow_oversell")

  /// Nombre maximal de tentatives d'appel avant bascule automatique en ANNULEE.
  maxCallAttempts Int @default(4) @map("max_call_attempts")

  /// Delai par defaut avant rappel, en heures.
  defaultCallbackDelayHours Int @default(4) @map("default_callback_delay_hours")

  // --- Filtre WhatsApp (Addendum §31) ---
  whatsappFilterEnabled   Boolean @default(false) @map("whatsapp_filter_enabled")
  /// Delai sans reponse avant retour en file d'appel humaine, en heures.
  whatsappTimeoutHours    Int     @default(3) @map("whatsapp_timeout_hours")
  /// Montant au-dela duquel la commande passe directement a un agent humain.
  whatsappMaxAmountCentimes Int?  @map("whatsapp_max_amount_centimes")

  // --- Score de fiabilite (Addendum §32) ---
  reliabilityEnabled          Boolean @default(true) @map("reliability_enabled")
  reliabilityMinHistory       Int     @default(3) @map("reliability_min_history")
  reliabilityReliableThreshold Int    @default(70) @map("reliability_reliable_threshold")
  reliabilityWatchThreshold   Int     @default(45) @map("reliability_watch_threshold")
  reliabilityFailureLimit     Int     @default(3) @map("reliability_failure_limit")
  /// Actions declenchees pour un client AT_RISK. Vide = aucune restriction.
  reliabilityAtRiskActions    String[] @default([]) @map("reliability_at_risk_actions")

  // --- Detection de doublons (V2 §19) ---
  duplicateWindowHours   Int @default(48) @map("duplicate_window_hours")
  duplicateAlertScore    Int @default(65) @map("duplicate_alert_score")
  duplicateLikelyScore   Int @default(85) @map("duplicate_likely_score")

  // --- Rentabilite (Addendum §33) ---
  /// Cout transport par defaut lorsque le transporteur ne le renvoie pas.
  defaultCarrierCostCentimes Int  @default(0) @map("default_carrier_cost_centimes")
  /// Seuil de taux de retour au-dela duquel une alerte est levee (en %).
  returnRateAlertPercent     Int? @map("return_rate_alert_percent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Avancement de l'assistant d'onboarding (Addendum §34).
model OnboardingProgress {
  tenantId       String    @id @map("tenant_id") @db.Uuid
  /// Etapes franchies, valeurs de `OnboardingStep` (packages/shared).
  completedSteps String[]  @default([]) @map("completed_steps")
  currentStep    String    @default("STORE_CREATED") @map("current_step")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  /// Resultat du dernier import de test, conserve pour affichage.
  testImportSummary Json?  @map("test_import_summary")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

/// Rattachement d'un utilisateur a une boutique, avec son role.
model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  invitedAt DateTime?        @map("invited_at") @db.Timestamptz(3)
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedOrders    Order[]            @relation("OrderAssignee")
  handledCalls      OrderCallAttempt[]
  preparedOrders    Order[]            @relation("OrderPreparedBy")

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

/// Role. `tenantId = null` designe un role de plateforme (SUPER_ADMIN).
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  scope       RoleScope @default(TENANT)
  /// Code stable (OWNER, MANAGER, ...) pour les roles systeme ; slug libre
  /// pour les roles personnalises.
  code        String
  name        String
  description String?
  /// Un role systeme ne peut pas etre supprime.
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  platformAssignments PlatformRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Cle stable `<domaine>.<action>` (voir packages/shared/src/permissions.ts).
  key         String   @unique
  group       String
  label       String
  description String
  sensitive   Boolean  @default(false)
  /// Vrai pour les permissions `platform.*`, jamais attribuables a un tenant.
  isPlatform  Boolean  @default(false) @map("is_platform")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Rattachement d'un utilisateur a un role de PLATEFORME (SUPER_ADMIN).
/// Separe de `Membership` car il n'est lie a aucun tenant.
model PlatformRoleAssignment {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("platform_role_assignments")
}

// ============================================================================
// AUTHENTIFICATION
// ============================================================================

/// Refresh token a rotation. Seul le HASH est stocke : une fuite de la base
/// ne permet pas de rejouer un token (V2 §31).
model RefreshToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  /// Famille de rotation : permet de revoquer toute la chaine en cas de rejeu.
  familyId       String    @map("family_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Renseigne lorsque ce token a ete echange contre un nouveau.
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Verification par OTP du numero de telephone (Addendum §38).
model OtpChallenge {
  id           String     @id @default(uuid(7)) @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  phoneE164    String     @map("phone_e164")
  purpose      OtpPurpose @default(PHONE_VERIFICATION)
  /// Hash du code : le code en clair n'est jamais persiste.
  codeHash     String     @map("code_hash")
  attempts     Int        @default(0)
  maxAttempts  Int        @default(5) @map("max_attempts")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneE164, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ============================================================================
// CLIENTS
// ============================================================================

model Customer {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  fullName        String   @map("full_name")
  /// Cle metier du client dans la boutique : E.164 normalise.
  phoneE164       String   @map("phone_e164")
  /// Langue dans laquelle ce client recoit ses messages. `null` tant qu'elle
  /// n'a pas ete observee ou renseignee : on retombe alors sur le reglage de
  /// la boutique, puis sur le francais.
  locale          String?
  /// Saisie d'origine, conservee pour tracabilite de l'import.
  phoneRaw        String?  @map("phone_raw")
  secondaryPhone  String?  @map("secondary_phone")
  email           String?
  notes           String?
  tags            String[] @default([])

  // --- Score de fiabilite, recalcule apres chaque issue de commande ---
  reliabilityScore  Int?            @map("reliability_score")
  reliabilityTier   ReliabilityTier @default(UNKNOWN) @map("reliability_tier")
  /// Facteurs explicatifs du score, pour affichage sans recalcul.
  reliabilityFactors Json?          @map("reliability_factors")
  reliabilityUpdatedAt DateTime?    @map("reliability_updated_at") @db.Timestamptz(3)

  // --- Compteurs materialises (maintenus transactionnellement) ---
  ordersCount       Int @default(0) @map("orders_count")
  deliveredCount    Int @default(0) @map("delivered_count")
  cancelledCount    Int @default(0) @map("cancelled_count")
  refusedCount      Int @default(0) @map("refused_count")
  returnedCount     Int @default(0) @map("returned_count")
  unreachableCount  Int @default(0) @map("unreachable_count")
  consecutiveFailures Int @default(0) @map("consecutive_failures")
  lastOrderAt       DateTime? @map("last_order_at") @db.Timestamptz(3)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Retire des listes, sans rien effacer. REVERSIBLE.
  ///
  /// A NE PAS CONFONDRE AVEC `anonymizedAt`, juste en dessous, et c'est toute
  /// la raison d'etre de ce champ : « retirer un client de ma liste » et
  /// « effacer les donnees personnelles d'un client » sont deux gestes que
  /// seul le second rend irreversible. Les confondre ferait d'un menage de
  /// liste une suppression definitive.
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]

  /// Un numero identifie un client unique DANS une boutique.
  @@unique([tenantId, phoneE164])
  @@index([tenantId, fullName])
  @@index([tenantId, reliabilityTier])
  @@index([tenantId, createdAt])
  @@map("customers")
}

model Address {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  customerId   String  @map("customer_id") @db.Uuid
  /// Code officiel de wilaya (1-58), resolu par packages/shared/src/algeria.ts.
  wilayaCode   Int     @map("wilaya_code")
  wilayaName   String  @map("wilaya_name")
  commune      String
  addressText  String  @map("address_text")
  /// Forme normalisee utilisee par la detection de doublons.
  addressNormalized String? @map("address_normalized")
  postalCode   String? @map("postal_code")
  isDefault    Boolean @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([tenantId, customerId])
  @@index([tenantId, wilayaCode])
  @@map("addresses")
}

// ============================================================================
// CATALOGUE ET STOCK
// ============================================================================

model ProductCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@map("product_categories")
}

model Product {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  categoryId           String?  @map("category_id") @db.Uuid
  name                 String
  /// SKU du produit parent. Les variantes portent leur propre SKU.
  sku                  String
  description          String?
  purchasePriceCentimes Int?    @map("purchase_price_centimes")
  salePriceCentimes    Int      @map("sale_price_centimes")
  imageUrls            String[] @default([]) @map("image_urls")
  /// Consignes lues par le confirmateur PENDANT l'appel : argument de vente,
  /// piege connu, question a poser. Affichees dans le tiroir de confirmation,
  /// pas dans un onglet du catalogue que personne n'ouvre au telephone.
  confirmationNotes    String?  @map("confirmation_notes")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  crossSells    ProductCrossSell[] @relation("CrossSellSource")
  crossSoldWith ProductCrossSell[] @relation("CrossSellTarget")
  deliveryFeeOverrides ProductDeliveryFeeOverride[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("products")
}

/// Variante vendable. TOUTE commande pointe sur une variante, jamais sur un
/// produit : un produit sans declinaison possede une variante « par defaut ».
/// Cela evite deux chemins de calcul de stock (V2 §14 : regles centralisees).
model ProductVariant {
  id                    String   @id @default(uuid(7)) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  sku                   String
  /// Libelle affichable de la declinaison : « Rouge / M ».
  label                 String?
  /// Attributs libres : { "couleur": "Rouge", "taille": "M" }.
  attributes            Json     @default("{}")
  purchasePriceCentimes Int?     @map("purchase_price_centimes")
  salePriceCentimes     Int?     @map("sale_price_centimes")
  lowStockThreshold     Int?     @map("low_stock_threshold")
  /// Voir `OutOfStockBehavior` : `INHERIT` laisse la boutique decider.
  outOfStockBehavior    OutOfStockBehavior @default(INHERIT) @map("out_of_stock_behavior")
  /// Ordre de consommation des lots. Sans lot, la valeur est sans effet.
  stockExitStrategy     StockExitStrategy  @default(FIFO) @map("stock_exit_strategy")
  isDefault             Boolean  @default(false) @map("is_default")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  level      InventoryLevel?
  movements  InventoryMovement[]
  batches    StockBatch[]
  orderItems OrderItem[]
  returnItems ReturnItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

/// Etat de stock courant d'une variante.
///
/// C'est une PROJECTION de `InventoryMovement`, maintenue dans la meme
/// transaction que le mouvement. Elle existe pour eviter un SUM sur tout
/// l'historique a chaque lecture ; un job de reconciliation verifie
/// periodiquement l'egalite projection == somme des mouvements.
model InventoryLevel {
  variantId  String @id @map("variant_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  /// Quantite physiquement detenue.
  onHand     Int    @default(0) @map("on_hand")
  /// Quantite engagee sur des commandes non encore sorties.
  reserved   Int    @default(0)
  /// Retours en attente de controle qualite.
  quarantine Int    @default(0)
  /// Verrou optimiste : incremente a chaque mouvement.
  version    Int    @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inventory_levels")
}

/// Journal append-only des mouvements de stock (V2 §14).
model InventoryMovement {
  id            String                 @id @default(uuid(7)) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  variantId     String                 @map("variant_id") @db.Uuid
  type          InventoryMovementType
  /// Quantite toujours POSITIVE : le sens est porte par `type`.
  quantity      Int
  referenceType InventoryReferenceType @map("reference_type")
  referenceId   String?                @map("reference_id") @db.Uuid
  actorId       String?                @map("actor_id") @db.Uuid
  note          String?
  /// Etat du stock apres application, fige pour audit.
  onHandAfter     Int @map("on_hand_after")
  reservedAfter   Int @map("reserved_after")
  quarantineAfter Int @map("quarantine_after")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@index([tenantId, createdAt])
  @@map("inventory_movements")
}

/// Lot de stock : une entree datee, avec son cout d'achat reel et, si la
/// marchandise se perime, sa date limite.
///
/// POURQUOI DES LOTS EN PLUS DE `InventoryLevel`
///   `InventoryLevel` repond a « combien en ai-je ? ». Il ne repond pas a
///   « lequel dois-je sortir en premier ? » ni a « celui-ci m'a coute
///   combien ? ». Deux receptions du meme article a deux prix differents
///   deviennent indiscernables des qu'elles sont additionnees : la marge
///   calculee ailleurs dans le produit utilise alors un prix d'achat moyen
///   implicite que personne n'a decide.
///
/// RAPPORT AVEC `InventoryLevel`
///   Les lots ne remplacent pas la projection : ils la DETAILLENT. La somme
///   des `remainingQuantity` d'une variante suivie par lots doit egaler son
///   `onHand`. Une variante sans aucun lot fonctionne exactement comme avant
///   — c'est ce qui rend l'adoption progressive, boutique par boutique.
model StockBatch {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  variantId    String    @map("variant_id") @db.Uuid
  /// Reference de reception (bon de livraison fournisseur), pour retrouver le
  /// lot physiquement en entrepot.
  reference    String?
  /// Quantite RECUE. Figee : c'est un fait de reception.
  quantity     Int
  /// Quantite non encore sortie. Decrementee a chaque sortie.
  remainingQuantity Int  @map("remaining_quantity")
  /// Cout d'achat UNITAIRE de ce lot, en centimes.
  costCentimes Int       @map("cost_centimes")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Sert les quatre strategies de sortie : FIFO/LIFO trient sur `receivedAt`,
  /// FEFO sur `expiresAt`. Le filtre porte toujours sur les lots non epuises.
  @@index([tenantId, variantId, receivedAt])
  @@index([tenantId, variantId, expiresAt])
  @@map("stock_batches")
}

/// Produit complementaire propose a la vente additionnelle.
///
/// Alimente le tiroir de confirmation : « vous prenez la housse avec ? » est
/// une question qui se pose pendant l'appel, quand le client est encore en
/// ligne. La table est ORIENTEE : proposer B avec A ne proposera pas A avec B,
/// parce que l'accessoire se vend avec le produit principal et rarement
/// l'inverse.
model ProductCrossSell {
  tenantId           String @map("tenant_id") @db.Uuid
  productId          String @map("product_id") @db.Uuid
  crossSellProductId String @map("cross_sell_product_id") @db.Uuid
  /// Ordre d'affichage dans le tiroir : le plus vendeur en premier.
  position           Int    @default(0)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product          Product @relation("CrossSellSource", fields: [productId], references: [id], onDelete: Cascade)
  crossSellProduct Product @relation("CrossSellTarget", fields: [crossSellProductId], references: [id], onDelete: Cascade)

  /// `tenantId` fait partie de la cle : deux boutiques peuvent lier les memes
  /// identifiants sans se marcher dessus, et le garde d'isolation retrouve son
  /// filtre sur la cle primaire elle-meme (D-004).
  @@id([tenantId, productId, crossSellProductId])
  @@index([tenantId, productId, position])
  @@map("product_cross_sells")
}

/// Grille des frais de livraison de la BOUTIQUE, une ligne par wilaya.
///
/// POURQUOI AU NIVEAU BOUTIQUE
///   Les frais de livraison dependent de la destination et du transporteur,
///   pas de l'article. Les porter sur la fiche produit obligerait a saisir 58
///   lignes par produit et a les corriger 58 fois a chaque changement de
///   tarif. La grille est donc unique, et le produit ne fait que la SURCHARGER
///   quand il a une raison de le faire (voir `ProductDeliveryFeeOverride`).
model TenantDeliveryFee {
  tenantId               String @map("tenant_id") @db.Uuid
  /// Code wilaya 1..58, ou `0` pour la ligne « Toutes les wilayas ».
  ///
  /// `0` est un SENTINELLE, pas une wilaya : il porte le tarif par defaut
  /// applique tant qu'aucune ligne precise n'existe. Une valeur nulle aurait
  /// ete plus explicite mais ne peut pas entrer dans une cle primaire ; `0`
  /// est hors du decoupage administratif (1..58), donc sans ambiguite, et une
  /// contrainte CHECK interdit toute autre valeur.
  wilayaCode             Int    @map("wilaya_code")
  homeFeeCentimes        Int    @map("home_fee_centimes")
  /// Livraison au bureau du transporteur. Le vocabulaire suit `DeliveryType`
  /// (`PICKUP_POINT`) plutot que le « stopdesk » du metier : une seule notion,
  /// un seul mot, de la commande jusqu'au bordereau.
  pickupPointFeeCentimes Int    @map("pickup_point_fee_centimes")
  /// Frais retenus quand le colis revient. Souvent non nuls en paiement a la
  /// livraison, et jusqu'ici absents du calcul de rentabilite.
  returnFeeCentimes      Int    @default(0) @map("return_fee_centimes")
  isActive               Boolean @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, wilayaCode])
  @@map("tenant_delivery_fees")
}

/// Surcharge de la grille pour un produit precis (volumineux, fragile,
/// livraison offerte).
///
/// Table volontairement CREUSE : on n'y ecrit que l'exception. Un produit sans
/// aucune ligne suit la grille de la boutique, ce qui est le cas courant.
model ProductDeliveryFeeOverride {
  tenantId               String @map("tenant_id") @db.Uuid
  productId              String @map("product_id") @db.Uuid
  /// Meme convention que la grille : `0` = toutes les wilayas.
  wilayaCode             Int    @map("wilaya_code")
  homeFeeCentimes        Int?   @map("home_fee_centimes")
  pickupPointFeeCentimes Int?   @map("pickup_point_fee_centimes")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([tenantId, productId, wilayaCode])
  @@map("product_delivery_fee_overrides")
}

// ============================================================================
// COMMANDES
// ============================================================================

/// Sequence de reference par (tenant, annee), pour produire ORD-AAAA-XXXXXX
/// sans collision entre imports concurrents.
model OrderSequence {
  tenantId String @map("tenant_id") @db.Uuid
  year     Int
  lastValue Int   @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
  @@map("order_sequences")
}

model Order {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  /// Reference lisible ORD-AAAA-XXXXXX, unique par boutique.
  reference  String
  /// Identifiant fourni par la source externe (ligne Sheets, API partenaire).
  externalOrderId String? @map("external_order_id")
  source     OrderSource @default(MANUAL)
  status     OrderStatus @default(NEW)

  customerId String  @map("customer_id") @db.Uuid
  addressId  String? @map("address_id") @db.Uuid
  /// Copies figees des coordonnees au moment de la commande : une correction
  /// ulterieure de la fiche client ne doit pas reecrire l'historique.
  customerNameSnapshot String  @map("customer_name_snapshot")
  phoneSnapshot        String  @map("phone_snapshot")
  wilayaCodeSnapshot   Int?    @map("wilaya_code_snapshot")
  communeSnapshot      String? @map("commune_snapshot")
  addressSnapshot      String? @map("address_snapshot")
  /// Domicile ou bureau (« stopdesk »). Convenu pendant l'appel de
  /// confirmation, puis transmis tel quel au transporteur a l'expedition.
  /// Auparavant, le mode n'existait qu'a l'instant de creer le colis et valait
  /// toujours « domicile » : ce que le client avait demande au telephone
  /// n'etait ecrit nulle part.
  deliveryType DeliveryType @default(HOME) @map("delivery_type")

  // --- Montants (centimes) ---
  itemsTotalCentimes    Int @default(0) @map("items_total_centimes")
  discountCentimes      Int @default(0) @map("discount_centimes")
  deliveryFeeCentimes   Int @default(0) @map("delivery_fee_centimes")
  /// Ajustement d'echange (SAV), en centimes, signe.
  ///
  /// DISTINCT DE LA REMISE, et c'est tout l'interet de la ligne. Une remise
  /// est un geste COMMERCIAL consenti avant la vente ; un echange est la
  /// difference de prix constatee APRES, quand le client rapporte un article
  /// et en repart avec un autre. Les confondre fausse deux chiffres a la
  /// fois : le taux de remise accorde, et le cout reel du service apres-vente.
  ///
  /// Positif = le client complete ; negatif = la boutique rembourse.
  exchangeAmountCentimes Int @default(0) @map("exchange_amount_centimes")
  totalCentimes         Int @default(0) @map("total_centimes")
  /// Cout reel facture par le transporteur (aller), renseigne a l'expedition.
  carrierCostCentimes   Int @default(0) @map("carrier_cost_centimes")
  /// Cout du retour, renseigne lors du traitement du retour.
  returnCostCentimes    Int @default(0) @map("return_cost_centimes")

  // --- Operations ---
  /// Transporteur choisi AVANT l'expedition.
  ///
  /// POURQUOI SUR LA COMMANDE, ET NON SEULEMENT SUR LE COLIS
  ///   `Shipment` porte deja le compte transporteur, mais il n'existe qu'a
  ///   partir du moment ou le colis est cree. Or le choix du livreur se fait
  ///   AVANT : on prepare une tournee, on repartit les commandes entre deux
  ///   societes, puis on expedie. Sans ce champ, ce choix n'avait nulle part ou
  ///   se poser et l'expedition retombait toujours sur le compte par defaut.
  ///
  ///   Une fois le colis cree, c'est `Shipment.carrierAccountId` qui fait foi :
  ///   ce champ-ci enregistre une INTENTION, celui-la un fait.
  carrierAccountId     String? @map("carrier_account_id") @db.Uuid
  assignedMembershipId String? @map("assigned_membership_id") @db.Uuid
  preparedByMembershipId String? @map("prepared_by_membership_id") @db.Uuid
  notes         String?
  internalNotes String? @map("internal_notes")
  /// Priorite de la file de confirmation : plus bas = traite en premier.
  queuePriority Int     @default(1) @map("queue_priority")
  callAttemptsCount Int @default(0) @map("call_attempts_count")
  nextCallbackAt DateTime? @map("next_callback_at") @db.Timestamptz(3)

  // --- Filtre WhatsApp (Addendum §31) ---
  confirmationChannel ConfirmationChannel @default(NOT_APPLICABLE) @map("confirmation_channel")
  whatsappState       WhatsappFilterState @default(NOT_ELIGIBLE) @map("whatsapp_state")

  /// Le stock a-t-il ete reserve pour cette commande ? Evite une double
  /// reservation lors d'une transition rejouee.
  stockReserved Boolean @default(false) @map("stock_reserved")
  stockReleased Boolean @default(false) @map("stock_released")

  // --- Dates metier (V1 §7) ---
  orderedAt   DateTime  @default(now()) @map("ordered_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  preparedAt  DateTime? @map("prepared_at") @db.Timestamptz(3)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  returnedAt  DateTime? @map("returned_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Suppression logique : l'historique metier n'est jamais detruit.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address  Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  carrierAccount CarrierAccount? @relation(fields: [carrierAccountId], references: [id], onDelete: SetNull)
  assignee Membership? @relation("OrderAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  preparedBy Membership? @relation("OrderPreparedBy", fields: [preparedByMembershipId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  callAttempts   OrderCallAttempt[]
  shipments      Shipment[]
  returns        Return[]
  sheetRowImport SheetRowImport?
  whatsappThread WhatsappThread?
  duplicateFlagsAsSubject   OrderDuplicateFlag[] @relation("DuplicateSubject")
  duplicateFlagsAsCandidate OrderDuplicateFlag[] @relation("DuplicateCandidate")

  @@unique([tenantId, reference])
  /// Garantit qu'une meme commande externe n'est jamais importee deux fois.
  @@unique([tenantId, source, externalOrderId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status, queuePriority, nextCallbackAt])
  @@index([tenantId, assignedMembershipId, status])
  @@index([tenantId, wilayaCodeSnapshot])
  @@index([tenantId, phoneSnapshot])
  @@index([tenantId, deliveredAt])
  @@index([tenantId, carrierAccountId, status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  /// Instantanes figes a la creation : le catalogue peut evoluer, la commande
  /// et le calcul de marge doivent rester exacts (Addendum §33).
  productNameSnapshot String @map("product_name_snapshot")
  skuSnapshot         String @map("sku_snapshot")
  variantLabelSnapshot String? @map("variant_label_snapshot")

  quantity                  Int
  unitPriceCentimes         Int  @map("unit_price_centimes")
  unitPurchasePriceCentimes Int? @map("unit_purchase_price_centimes")
  discountCentimes          Int  @default(0) @map("discount_centimes")
  lineTotalCentimes         Int  @map("line_total_centimes")

  /// Quantite reellement preparee, saisie par le preparateur.
  preparedQuantity Int? @map("prepared_quantity")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([tenantId, orderId])
  @@index([tenantId, variantId])
  @@map("order_items")
}

/// Journal append-only des transitions de statut (V2 §10).
model OrderStatusHistory {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus  @map("new_status")
  actorKind ActorKind    @default(USER) @map("actor_kind")
  actorId   String?      @map("actor_id") @db.Uuid
  /// Origine de la transition : UI, webhook transporteur, job, filtre WhatsApp.
  source    String
  reason    String?
  note      String?
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, newStatus, createdAt])
  @@map("order_status_history")
}

/// Tentative de contact du centre de confirmation (V2 §11).
model OrderCallAttempt {
  id           String      @id @default(uuid(7)) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  membershipId String?     @map("membership_id") @db.Uuid
  attemptNumber Int        @map("attempt_number")
  outcome      CallOutcome
  note         String?
  scheduledCallbackAt DateTime? @map("scheduled_callback_at") @db.Timestamptz(3)
  durationSeconds Int?     @map("duration_seconds")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([orderId, attemptNumber])
  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, membershipId, createdAt])
  @@map("order_call_attempts")
}

/// Signalement de doublon potentiel. N'ANNULE JAMAIS de commande : la decision
/// appartient a un utilisateur habilite (V1 §15, V2 §19).
model OrderDuplicateFlag {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  subjectOrderId   String              @map("subject_order_id") @db.Uuid
  candidateOrderId String              @map("candidate_order_id") @db.Uuid
  score            Int
  confidence       DuplicateConfidence
  matchedRules     String[]            @map("matched_rules")
  explanation      String[]
  resolution       DuplicateResolution @default(PENDING)
  resolvedByMembershipId String?       @map("resolved_by_membership_id") @db.Uuid
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectOrder   Order  @relation("DuplicateSubject", fields: [subjectOrderId], references: [id], onDelete: Cascade)
  candidateOrder Order  @relation("DuplicateCandidate", fields: [candidateOrderId], references: [id], onDelete: Cascade)

  @@unique([subjectOrderId, candidateOrderId])
  @@index([tenantId, resolution, createdAt])
  @@map("order_duplicate_flags")
}

// ============================================================================
// EXPEDITION ET TRACKING
// ============================================================================

/// Transporteur supporte par la plateforme. Le catalogue est global ; chaque
/// boutique active les transporteurs qu'elle utilise via `CarrierAccount`.
/// Commune algerienne, rattachee a sa wilaya par le code administratif.
///
/// POURQUOI EN BASE, ALORS QUE LES WILAYAS SONT EN CODE
///   Les deux referentiels n'ont pas le meme usage, et c'est l'usage qui decide
///   ou ils vivent.
///
///   Les 58 wilayas sont lues a CHAQUE ligne d'import, pour resoudre
///   « Algiers », « BBA » ou « Bejaia » en un code. Ce travail doit etre
///   synchrone et local : le faire passer par une requete transformerait chaque
///   import de mille lignes en mille allers-retours. Elles restent donc dans
///   `@ecomflow/shared` (D-018).
///
///   Les 1541 communes, elles, servent a CHOISIR dans une liste et a retrouver
///   un libelle. Embarquees dans le paquet partage — qui est compile en
///   CommonJS, donc mal elague — elles partiraient dans le bundle de CHAQUE
///   page du produit, y compris celles qui n'ont pas de champ adresse.
///
/// CE MODELE NE VALIDE RIEN
///   D-018 refuse de rejeter une commande parce que sa commune ne figure pas
///   dans une liste : les transliterations varient trop d'un transporteur a
///   l'autre pour qu'une absence signifie une erreur. Ce referentiel ASSISTE la
///   saisie (il remplit une liste deroulante) ; il ne ferme pas la porte a une
///   commune qu'il ne connait pas.
model Commune {
  id         String  @id @default(uuid(7)) @db.Uuid
  /// Code administratif de la wilaya de rattachement, 1 a 58.
  wilayaCode Int     @map("wilaya_code")
  /// Libelle affichable : « Ouled Djellal ».
  name       String
  /// Forme normalisee, produite par `normalizeGeoName` de `@ecomflow/shared` :
  /// minuscules, sans accents ni separateurs — « Ouled Djellal » devient
  /// « ouleddjellal ».
  ///
  /// C'est la MEME fonction qui normalise le libelle saisi avant la recherche.
  /// Deux regles differentes — l'une a la generation, l'autre a la lecture — ne
  /// se rencontreraient jamais, et la table paraitrait vide alors qu'elle est
  /// pleine.
  searchName String  @map("search_name")
  isActive   Boolean @default(true) @map("is_active")

  /// Un meme libelle normalise ne peut pas exister deux fois dans une wilaya —
  /// mais le meme nom dans DEUX wilayas est frequent et legitime.
  @@unique([wilayaCode, searchName])
  @@index([wilayaCode, name])
  @@map("communes")
}

model Carrier {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Code du connecteur (YALIDINE, ZR_EXPRESS, ECOTRACK, MOCK...).
  code        String   @unique
  name        String
  /// Le connecteur supporte-t-il les webhooks de tracking ?
  supportsWebhooks Boolean @default(false) @map("supports_webhooks")
  supportsCancellation Boolean @default(true) @map("supports_cancellation")
  /// Etat d'integration : AVAILABLE (adaptateur verifie contre un compte reel),
  /// UNVERIFIED (adaptateur ecrit d'apres des sources tierces, jamais
  /// confronte), PLANNED (aucun adaptateur). Voir D-066 et D-070.
  implementationStatus String @default("AVAILABLE") @map("implementation_status")
  /// Pourquoi le catalogue en sait si peu — code stable, traduit a l'ecran :
  /// THIRD_PARTY_SOURCES, DOCUMENTATION_REQUESTED, ADDRESSING_REWORK. `null`
  /// quand il n'y a rien a dire, ce qui est le cas d'un transporteur verifie.
  sourceNote  String?  @map("source_note")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts  CarrierAccount[]
  shipments Shipment[]
  capability      CarrierCapability?
  wilayaCoverage  CarrierWilayaCoverage[]

  @@map("carriers")
}

/// Configuration d'un transporteur pour une boutique. Les secrets sont
/// chiffres au repos (AES-256-GCM) et jamais exposes au frontend (V2 §16).
model CarrierAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  carrierId     String            @map("carrier_id") @db.Uuid
  label         String
  /// Agent independant ou societe : voir `CarrierAccountKind`.
  kind          CarrierAccountKind @default(DELIVERY_COMPANY)
  status        IntegrationStatus @default(PENDING_SETUP)
  /// Blob chiffre contenant identifiants et cles d'API.
  credentialsEncrypted String?    @map("credentials_encrypted")
  /// Parametres non sensibles : adresse d'enlevement, options de service.
  config        Json              @default("{}")
  isDefault     Boolean           @default(false) @map("is_default")

  /// Transmettre le NUMERO DE COMMANDE de la source plutot que la reference
  /// EcomFlow.
  ///
  /// Au telephone, le commercant cite le numero qu'il a sous les yeux — celui
  /// de sa feuille ou de sa boutique en ligne. Si le transporteur a enregistre
  /// « ORD-2026-000123 », personne ne retrouve le colis. A defaut de numero
  /// externe (commande saisie a la main), la reference EcomFlow reste envoyee :
  /// mieux vaut une reference que rien.
  sendOrderNumberInsteadOfReference Boolean @default(false) @map("send_order_number_instead_of_reference")

  /// Le transporteur detient physiquement le stock de la boutique.
  ///
  /// Change la logique de reservation : la marchandise est deja chez lui, il
  /// n'y a pas d'enlevement a organiser, et le stock EcomFlow decrit un depot
  /// distant. Le drapeau est porte ici plutot que sur le transporteur : c'est
  /// un arrangement entre CETTE boutique et lui, pas une propriete du reseau.
  stockHeldByCourier Boolean @default(false) @map("stock_held_by_courier")

  lastHealthCheckAt DateTime?     @map("last_health_check_at") @db.Timestamptz(3)
  lastHealthCheckOk Boolean?      @map("last_health_check_ok")
  lastErrorMessage  String?       @map("last_error_message")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier   Carrier    @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  shipments Shipment[]
  orders    Order[]

  @@unique([tenantId, carrierId, label])
  @@index([tenantId, status])
  @@map("carrier_accounts")
}

/// Matrice des capacites d'un connecteur transporteur — une ligne par
/// transporteur, une colonne booleenne par capacite.
///
/// A QUOI CA SERT, CONCRETEMENT
///   A ne pas afficher une action que le transporteur ne sait pas faire. Un
///   bouton « Supprimer la commande » grise apres coup, ou pire, qui echoue
///   une fois clique, coute un appel client et une perte de confiance. La
///   matrice permet a l'interface de ne PAS dessiner ce qui n'existe pas.
///
/// LES DIX-SEPT VIENNENT DE L'AUDIT
///   Cette liste et ses intitules suivent la matrice de l'audit fonctionnel
///   Ecomanager, et non le contrat `CarrierAdapter`. C'est deliberé : la
///   matrice decrit ce qu'un transporteur ALGERIEN propose a un commercant,
///   dans les mots de ce metier. Le contrat d'adaptateur, lui, decrit comment
///   notre code lui parle — ce sont deux decoupages differents, et les
///   confondre reviendrait a faire dependre le vocabulaire produit de nos
///   choix d'implementation. Les ecarts subsistants sont journalises en D-049.
///
/// POURQUOI DES COLONNES EXPLICITES ET NON UN JSON
///   Un JSON serait plus souple a etendre, mais la souplesse n'est pas la
///   qualite recherchee ici. Trois raisons ont tranche :
///
///     1. Ces booleens pilotent l'affichage d'actions reelles. Ils sont
///        alimentes par le catalogue de seed, en regard de ce que chaque
///        adaptateur sait honorer. Un blob editable a la main derive de
///        l'implementation, et l'interface se remet alors a proposer des
///        actions impossibles — le defaut meme que la matrice doit supprimer.
///     2. « Quels transporteurs poussent les bons d'encaissement en temps
///        reel ? » est une question qu'on pose au comparatif. Elle s'ecrit en
///        SQL sur une colonne ; sur un JSON, elle s'ecrit mal et ne s'indexe
///        pas.
///     3. Ajouter une capacite DOIT couter une migration, parce que cela veut
///        dire l'implementer dans chaque adaptateur. Le cout est ici un
///        signal, pas une friction.
model CarrierCapability {
  carrierId String @id @map("carrier_id") @db.Uuid

  // --- Commandes ------------------------------------------------------------
  /// Ajout d'une commande chez le transporteur.
  addOrder      Boolean @default(true)  @map("add_order")
  /// Ajout en masse : depose un lot de commandes en un appel. Sans lui, une
  /// journee de cent commandes se pousse cent fois.
  addOrderBulk  Boolean @default(false) @map("add_order_bulk")
  /// Suppression d'une commande deja deposee. C'est l'operation que le
  /// contrat `CarrierAdapter` nomme `cancelShipment` : meme geste, deux
  /// vocabulaires (voir D-049).
  deleteOrder   Boolean @default(false) @map("delete_order")
  /// Le transporteur rend-il une etiquette imprimable ?
  ///
  /// DIX-HUITIEME COLONNE, HORS LISTE DE L'AUDIT — et c'est assume : le
  /// PRINCIPE de l'audit (« ne jamais afficher une action non supportee »)
  /// prime sur le chiffre. `Shipment.labelUrl` commande un lien visible dans
  /// deux ecrans ; sans cette colonne, son absence est muette et l'exploitant
  /// ne peut pas distinguer « ce transporteur n'en produit pas » de « la
  /// creation a echoue ». Voir D-049.
  printableLabel Boolean @default(false) @map("printable_label")

  // --- Synchronisation (relevé periodique) ---------------------------------
  //
  // Le transporteur est INTERROGE. Les trois etats sont distincts parce qu'ils
  // le sont chez les transporteurs : beaucoup renvoient « livre » sans jamais
  // detailler les tentatives, et c'est precisement la tentative qui declenche
  // le rappel du client.
  syncAttempted Boolean @default(false) @map("sync_attempted")
  syncDelivered Boolean @default(true)  @map("sync_delivered")
  syncFailed    Boolean @default(false) @map("sync_failed")

  // --- Synchronisation temps reel (le transporteur POUSSE) -----------------
  //
  // Meme information, mode d'acheminement different — et la difference
  // opperationnelle est reelle : un statut releve toutes les heures ne permet
  // pas de rappeler un client dans la demi-heure qui suit un echec.
  /// Wilayas devenues non livrables (greve, meteo, fermeture d'agence).
  realtimeUndeliverableWilayas Boolean @default(false) @map("realtime_undeliverable_wilayas")
  realtimeAttempted            Boolean @default(false) @map("realtime_attempted")
  realtimeDelivered            Boolean @default(false) @map("realtime_delivered")
  realtimeFailed               Boolean @default(false) @map("realtime_failed")
  /// Bons d'encaissement : ce que le transporteur a REELLEMENT reverse. En
  /// paiement a la livraison, c'est la seule source qui dit si l'argent est
  /// rentre — un colis « livre » n'est pas un colis paye.
  realtimeCollectionVouchers   Boolean @default(false) @map("realtime_collection_vouchers")
  /// Changement d'adresse accepte apres depot, et repercute.
  realtimeAddressChange        Boolean @default(false) @map("realtime_address_change")
  /// Changement du montant a encaisser apres depot.
  realtimePriceChange          Boolean @default(false) @map("realtime_price_change")

  // --- Livraison et service apres-vente ------------------------------------
  /// Retrait au bureau du transporteur. Le metier dit « stop desk » ; la
  /// commande, elle, porte `DeliveryType.PICKUP_POINT`. Meme notion, deux
  /// registres assumes (D-049).
  stopDesk           Boolean @default(false) @map("stop_desk")
  /// SAV : echange d'un article contre un autre a la livraison.
  afterSalesExchange Boolean @default(false) @map("after_sales_exchange")
  /// SAV : reprise d'un article chez le client, sans echange.
  afterSalesPickup   Boolean @default(false) @map("after_sales_pickup")

  // --- Logistique -----------------------------------------------------------
  /// Le transporteur SAIT detenir du stock pour le compte d'une boutique.
  /// Distinct de `CarrierAccount.stockHeldByCourier`, qui dit si CETTE
  /// boutique s'en sert : l'un est une aptitude du reseau, l'autre un
  /// arrangement commercial (D-051).
  stockAtCarrier Boolean @default(false) @map("stock_at_carrier")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@map("carrier_capabilities")
}

/// Couverture d'une wilaya par un transporteur, mode par mode.
///
/// POURQUOI PAR TRANSPORTEUR ET NON PAR BOUTIQUE
///   Une wilaya desservie l'est pour tout le monde : c'est un fait du reseau du
///   transporteur, pas un choix de la boutique. La grille tarifaire, elle,
///   appartient bien a la boutique (`TenantDeliveryFee`) — les deux repondent a
///   deux questions differentes : « peut-on livrer la ? » et « combien le
///   facture-t-on au client ? ».
///
/// L'ABSENCE DE LIGNE N'EST PAS UN REFUS
///   Une wilaya sans ligne signifie « couverture inconnue », pas « non
///   desservie » : tant que le tableau n'est pas rempli, l'interface ne doit
///   rien affirmer. C'est la raison pour laquelle il n'y a pas de valeur par
///   defaut couvrant les 58 wilayas.
model CarrierWilayaCoverage {
  carrierId   String  @map("carrier_id") @db.Uuid
  /// Code wilaya 1..58. Pas de sentinelle « toutes » ici : une couverture
  /// s'etablit wilaya par wilaya, et un « partout » global serait une
  /// affirmation que le reseau ne tient jamais tout a fait.
  wilayaCode  Int     @map("wilaya_code")
  homeDelivery Boolean @default(false) @map("home_delivery")
  /// Retrait au bureau. Meme vocabulaire que `DeliveryType.PICKUP_POINT`.
  pickupPoint Boolean @default(false) @map("pickup_point")
  /// Delai indicatif annonce par le transporteur, en jours.
  leadTimeDays Int?   @map("lead_time_days")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@id([carrierId, wilayaCode])
  @@index([wilayaCode])
  @@map("carrier_wilaya_coverage")
}

model Shipment {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  carrierId        String         @map("carrier_id") @db.Uuid
  carrierAccountId String         @map("carrier_account_id") @db.Uuid

  trackingNumber   String?        @map("tracking_number")
  /// Identifiant du colis chez le transporteur, si different du tracking.
  providerShipmentId String?      @map("provider_shipment_id")
  /// Cle envoyee au transporteur pour empecher un double colis cote fournisseur.
  idempotencyKey   String         @map("idempotency_key")

  status           ShipmentStatus @default(DRAFT)
  /// Statut brut renvoye par le transporteur, conserve pour diagnostic (V2 §17).
  providerStatus   String?        @map("provider_status")
  normalizedStatus ShipmentStatus? @map("normalized_status")

  labelUrl         String?        @map("label_url")
  costCentimes     Int?           @map("cost_centimes")
  weightGrams      Int?           @map("weight_grams")

  // --- Encaissement (paiement a la livraison) ------------------------------
  //
  // « LIVRE » NE VEUT PAS DIRE « PAYE ».
  //   C'est la distinction la plus couteuse du commerce en paiement a la
  //   livraison : un colis remis au client ne devient de l'argent qu'au moment
  //   ou le transporteur reverse la somme. Entre les deux, il peut s'ecouler
  //   des semaines — et c'est la que disparaissent les montants qu'une boutique
  //   ne reclame jamais, faute de savoir lesquels manquent.
  //
  // TROIS ETATS, ET LE TROISIEME COMPTE AUTANT QUE LES DEUX AUTRES
  //   `collectedCentimes` non nul  : le transporteur a reverse, on sait combien.
  //   `collectedCentimes` nul      : pas encore reverse — a reclamer.
  //   Capacite absente             : ce transporteur ne publie PAS cette
  //                                  donnee. L'ecran doit le dire au lieu
  //                                  d'afficher un vide qui se lit comme
  //                                  « impaye ».
  //   Le troisieme etat se lit sur `CarrierCapability.realtimeCollectionVouchers`,
  //   pas ici : l'absence de valeur ne dit pas d'elle-meme laquelle des deux
  //   raisons s'applique.
  /// Montant REELLEMENT reverse par le transporteur, en centimes.
  collectedCentimes Int?          @map("collected_centimes")
  collectedAt      DateTime?      @map("collected_at") @db.Timestamptz(3)
  /// Reference du bon d'encaissement chez le transporteur, pour reclamer.
  remittanceReference String?     @map("remittance_reference")

  errorCode        String?        @map("error_code")
  errorMessage     String?        @map("error_message")
  attemptCount     Int            @default(0) @map("attempt_count")
  lastSyncedAt     DateTime?      @map("last_synced_at") @db.Timestamptz(3)

  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt      DateTime?      @map("cancelled_at") @db.Timestamptz(3)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        Carrier        @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  carrierAccount CarrierAccount @relation(fields: [carrierAccountId], references: [id], onDelete: Restrict)
  events         ShipmentEvent[]
  returns        Return[]

  /// Empeche techniquement la creation de deux colis pour la meme commande
  /// avec la meme cle (V2 §17 : « eviter de creer deux colis »).
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, carrierId, trackingNumber])
  @@index([tenantId, orderId])
  @@index([tenantId, status, lastSyncedAt])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  shipmentId       String          @map("shipment_id") @db.Uuid
  providerStatus   String          @map("provider_status")
  normalizedStatus ShipmentStatus  @map("normalized_status")
  description      String?
  location         String?
  occurredAt       DateTime        @map("occurred_at") @db.Timestamptz(3)
  /// Empreinte de l'evenement fournisseur : rend le rejeu d'un webhook
  /// inoffensif (V2 §30 : « verifier signature, timestamp et idempotency »).
  fingerprint      String
  rawPayload       Json?           @map("raw_payload")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, fingerprint])
  @@index([tenantId, shipmentId, occurredAt])
  @@map("shipment_events")
}

// ============================================================================
// RETOURS
// ============================================================================

model Return {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  shipmentId   String?       @map("shipment_id") @db.Uuid
  reference    String
  reason       ReturnReason
  reasonDetail String?       @map("reason_detail")
  status       ReturnStatus  @default(PENDING)
  productCondition ProductCondition @default(UNKNOWN) @map("product_condition")
  stockDecision    StockDecision    @default(PENDING) @map("stock_decision")
  returnCostCentimes Int      @default(0) @map("return_cost_centimes")
  notes        String?
  createdByMembershipId String? @map("created_by_membership_id") @db.Uuid
  receivedAt   DateTime?     @map("received_at") @db.Timestamptz(3)
  inspectedAt  DateTime?     @map("inspected_at") @db.Timestamptz(3)
  closedAt     DateTime?     @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  items    ReturnItem[]

  @@unique([tenantId, reference])
  /// Un seul retour OUVERT par commande : la contrainte est un index UNIQUE
  /// PARTIEL (status NOT IN CLOSED/CANCELLED) cree dans la migration
  /// `20260829000100_integrity_constraints`. Prisma ne sait pas exprimer un
  /// index partiel ; il n'est donc pas declare ici, mais il est bien applique
  /// en base et couvert par un test d'integration.
  @@index([tenantId, orderId])
  @@index([tenantId, status, createdAt])
  @@map("returns")
}

model ReturnItem {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  returnId    String           @map("return_id") @db.Uuid
  orderItemId String           @map("order_item_id") @db.Uuid
  variantId   String           @map("variant_id") @db.Uuid
  quantity    Int
  condition   ProductCondition @default(UNKNOWN)
  stockDecision StockDecision  @default(PENDING) @map("stock_decision")
  /// Vrai une fois le mouvement de stock applique : garantit l'idempotence
  /// du traitement de retour.
  stockApplied Boolean         @default(false) @map("stock_applied")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  return    Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId, returnId])
  @@map("return_items")
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

model Integration {
  id        String            @id @default(uuid(7)) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  type      IntegrationType
  /// GOOGLE_SHEETS, WHATSAPP_CLOUD, CHARGILY...
  provider  String
  label     String?
  status    IntegrationStatus @default(DISCONNECTED)
  /// Blob chiffre : tokens OAuth, secrets d'API. Jamais expose au frontend.
  credentialsEncrypted String? @map("credentials_encrypted")
  config    Json              @default("{}")
  /// Compte externe lisible (email Google, numero WhatsApp) pour l'UI.
  accountLabel String?        @map("account_label")
  lastErrorCode String?       @map("last_error_code")
  lastErrorMessage String?    @map("last_error_message")
  lastCheckedAt DateTime?     @map("last_checked_at") @db.Timestamptz(3)
  connectedAt  DateTime?      @map("connected_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sheetConfigs SheetSyncConfig[]
  syncRuns     SyncRun[]
  whatsappThreads WhatsappThread[]

  @@unique([tenantId, provider])
  @@index([tenantId, type, status])
  @@map("integrations")
}

/// Configuration d'une feuille Google synchronisee (V2 §12).
model SheetSyncConfig {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  spreadsheetId String   @map("spreadsheet_id")
  spreadsheetName String? @map("spreadsheet_name")
  /// Nom de l'onglet (title) et identifiant numerique stable.
  sheetName     String   @map("sheet_name")
  sheetGid      String   @map("sheet_gid")
  /// Ligne d'en-tete (1-indexee) et premiere ligne de donnees.
  headerRow     Int      @default(1) @map("header_row")
  firstDataRow  Int      @default(2) @map("first_data_row")
  /// Mapping colonne source -> champ EcomFlow.
  /// { "date": "A", "customerName": "B", "phone": "C", ... }
  columnMapping Json     @map("column_mapping")
  /// Colonne portant un identifiant de ligne stable, si le commercant en a une.
  externalIdColumn String? @map("external_id_column")
  /// Le connecteur ecrit-il le statut EcomFlow en retour dans la feuille ?
  writeBackStatus Boolean @default(false) @map("write_back_status")
  writeBackColumn String? @map("write_back_column")
  /// Filtre optionnel : n'importer que les lignes dont le statut source
  /// figure dans cette liste.
  acceptedSourceStatuses String[] @default([]) @map("accepted_source_statuses")

  isActive      Boolean  @default(true) @map("is_active")
  syncIntervalMinutes Int @default(10) @map("sync_interval_minutes")
  /// Decalage applique a la planification pour etaler la charge entre
  /// boutiques et rester sous les quotas Google (Addendum §39).
  scheduleOffsetSeconds Int @default(0) @map("schedule_offset_seconds")
  lastSyncAt    DateTime? @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  /// Position de reprise : derniere ligne source traitee avec succes.
  lastProcessedRow Int   @default(0) @map("last_processed_row")
  consecutiveFailures Int @default(0) @map("consecutive_failures")
  /// Date avant laquelle aucune synchronisation ne doit etre tentee
  /// (backoff apres HTTP 429).
  backoffUntil  DateTime? @map("backoff_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  rowImports  SheetRowImport[]
  syncRuns    SyncRun[]

  @@unique([tenantId, spreadsheetId, sheetGid])
  @@index([tenantId, isActive])
  @@index([isActive, lastSyncAt])
  @@map("sheet_sync_configs")
}

/// Trace d'une ligne source traitee. La contrainte UNIQUE sur `fingerprint`
/// est le mecanisme d'idempotence de l'import (V2 §12, §29).
model SheetRowImport {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  configId     String          @map("config_id") @db.Uuid
  /// Hash stable de la ligne (id externe ou empreinte des valeurs metier).
  fingerprint  String
  /// Numero de ligne dans la feuille, informatif uniquement : il ne sert
  /// JAMAIS de cle d'idempotence (une insertion decalerait tout).
  sourceRowNumber Int?         @map("source_row_number")
  externalRowId String?        @map("external_row_id")
  status       ImportRowStatus
  errorCode    String?         @map("error_code")
  errorMessage String?         @map("error_message")
  /// Valeurs brutes de la ligne, conservees pour rejouer un import en erreur.
  rawValues    Json?           @map("raw_values")
  orderId      String?         @unique @map("order_id") @db.Uuid
  syncRunId    String?         @map("sync_run_id") @db.Uuid
  retryCount   Int             @default(0) @map("retry_count")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config  SheetSyncConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  syncRun SyncRun?        @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([configId, fingerprint])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, configId, createdAt])
  @@map("sheet_row_imports")
}

/// Execution d'une synchronisation, observable dans l'UI (V2 §30).
model SyncRun {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  integrationId String?     @map("integration_id") @db.Uuid
  configId      String?     @map("config_id") @db.Uuid
  trigger       SyncTrigger @default(SCHEDULED)
  status        RunStatus   @default(QUEUED)

  rowsScanned   Int @default(0) @map("rows_scanned")
  rowsImported  Int @default(0) @map("rows_imported")
  rowsSkipped   Int @default(0) @map("rows_skipped")
  rowsFailed    Int @default(0) @map("rows_failed")

  attempt       Int       @default(1)
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")
  /// Renseigne sur HTTP 429 : instant a partir duquel reprendre.
  retryAfter    DateTime? @map("retry_after") @db.Timestamptz(3)

  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  durationMs    Int?      @map("duration_ms")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration?     @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  config      SheetSyncConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  rowImports  SheetRowImport[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([configId, createdAt])
  @@map("sync_runs")
}

/// Import manuel de fichier CSV / Excel (V2 §24).
model ImportJob {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  createdByMembershipId String? @map("created_by_membership_id") @db.Uuid
  fileName     String    @map("file_name")
  fileSize     Int       @map("file_size")
  /// Hash du contenu : un re-upload du meme fichier est detecte.
  fileHash     String    @map("file_hash")
  format       String
  columnMapping Json     @map("column_mapping")
  status       RunStatus @default(QUEUED)
  rowsTotal    Int       @default(0) @map("rows_total")
  rowsImported Int       @default(0) @map("rows_imported")
  rowsSkipped  Int       @default(0) @map("rows_skipped")
  rowsFailed   Int       @default(0) @map("rows_failed")
  errorReport  Json?     @map("error_report")
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fileHash])
  @@index([tenantId, createdAt])
  @@map("import_jobs")
}

/// Export asynchrone (V2 §24 : « les gros exports doivent etre traites en
/// tache asynchrone »).
model ExportJob {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  requestedByMembershipId String? @map("requested_by_membership_id") @db.Uuid
  resource  String
  format    ExportFormat
  filters   Json         @default("{}")
  status    RunStatus    @default(QUEUED)
  rowCount  Int?         @map("row_count")
  fileUrl   String?      @map("file_url")
  fileSize  Int?         @map("file_size")
  errorMessage String?   @map("error_message")
  /// Les exports contiennent des donnees personnelles : ils expirent.
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz(3)
  startedAt DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?   @map("finished_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("export_jobs")
}

/// Cle d'idempotence generique pour les endpoints d'ecriture couteux.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  scope        String
  key          String
  /// Hash du corps de requete : un rejeu avec un contenu different est refuse.
  requestHash  String   @map("request_hash")
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Webhook entrant deja traite. Table GLOBALE (pas de tenantId) : la
/// deduplication doit avoir lieu avant meme d'avoir resolu le tenant.
model ProcessedWebhook {
  id          String   @id @default(uuid(7)) @db.Uuid
  provider    String
  /// Identifiant d'evenement fourni par le prestataire, ou hash du payload.
  eventId     String   @map("event_id")
  tenantId    String?  @map("tenant_id") @db.Uuid
  signatureOk Boolean  @map("signature_ok")
  statusCode  Int      @map("status_code")
  errorMessage String? @map("error_message")
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("processed_webhooks")
}

// ============================================================================
// WHATSAPP (Addendum §31)
// ============================================================================

model WhatsappThread {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  integrationId String?             @map("integration_id") @db.Uuid
  orderId       String              @unique @map("order_id") @db.Uuid
  phoneE164     String              @map("phone_e164")
  state         WhatsappFilterState @default(PENDING)
  /// Instant au-dela duquel l'absence de reponse renvoie la commande en
  /// file d'appel humaine.
  timeoutAt     DateTime?           @map("timeout_at") @db.Timestamptz(3)
  handedOverAt  DateTime?           @map("handed_over_at") @db.Timestamptz(3)
  handoverReason String?            @map("handover_reason")
  lastErrorCode String?             @map("last_error_code")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration?      @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages    WhatsappMessage[]

  @@index([tenantId, state, timeoutAt])
  @@map("whatsapp_threads")
}

model WhatsappMessage {
  id          String   @id @default(uuid(7)) @db.Uuid
  threadId    String   @map("thread_id") @db.Uuid
  direction   String
  /// Identifiant du message chez le fournisseur : cle d'idempotence entrante.
  providerMessageId String? @unique @map("provider_message_id")
  templateName String? @map("template_name")
  body        String?
  /// Reponse structuree du client : CONFIRM / MODIFY / CANCEL.
  buttonPayload String? @map("button_payload")
  status      String   @default("PENDING")
  errorMessage String? @map("error_message")
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  thread WhatsappThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("whatsapp_messages")
}

// ============================================================================
// ABONNEMENT ET PAIEMENTS
// ============================================================================

model Plan {
  id            String        @id @default(uuid(7)) @db.Uuid
  code          String        @unique
  name          String
  description   String?
  priceCentimes Int           @map("price_centimes")
  billingPeriod BillingPeriod @default(MONTHLY) @map("billing_period")
  /// Limites du plan : { "ordersPerMonth": 1000, "users": 5, "integrations": 2 }.
  /// JAMAIS codees en dur cote frontend (V2 §38).
  limits        Json          @default("{}")
  features      Json          @default("{}")
  isPublic      Boolean       @default(true) @map("is_public")
  isActive      Boolean       @default(true) @map("is_active")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id       String             @id @default(uuid(7)) @db.Uuid
  tenantId String             @unique @map("tenant_id") @db.Uuid
  planId   String?            @map("plan_id") @db.Uuid
  /// Statut PERSISTE, recalcule par `deriveSubscriptionState` cote serveur.
  /// Le frontend ne fait que l'afficher (V2 §7, §38).
  status   SubscriptionStatus @default(TRIAL_ACTIVE)

  trialStartAt       DateTime? @map("trial_start_at") @db.Timestamptz(3)
  trialEndAt         DateTime? @map("trial_end_at") @db.Timestamptz(3)
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  suspendedAt        DateTime? @map("suspended_at") @db.Timestamptz(3)
  pastDueSince       DateTime? @map("past_due_since") @db.Timestamptz(3)

  /// Derniere evaluation serveur, pour tracer les bascules automatiques.
  lastEvaluatedAt DateTime? @map("last_evaluated_at") @db.Timestamptz(3)
  /// Rappels d'expiration deja envoyes : [3, 1, 0].
  remindersSent   Int[]     @default([]) @map("reminders_sent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([status, trialEndAt])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  subscriptionId String?         @map("subscription_id") @db.Uuid
  planId         String?         @map("plan_id") @db.Uuid
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  amountCentimes Int             @map("amount_centimes")
  currency       String          @default("DZD")

  /// Identifiant de la transaction chez le prestataire (checkout Chargily).
  externalPaymentId String?      @unique @map("external_payment_id")
  checkoutUrl       String?      @map("checkout_url")
  /// Empreinte du dernier webhook applique : rend le rejeu inoffensif.
  lastWebhookEventId String?     @map("last_webhook_event_id")

  // --- Paiement manuel (Addendum §35) ---
  proofUrl        String?   @map("proof_url")
  proofUploadedAt DateTime? @map("proof_uploaded_at") @db.Timestamptz(3)
  reviewedByUserId String?  @map("reviewed_by_user_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote      String?   @map("review_note")

  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(3)
  errorMessage String?  @map("error_message")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Empreinte d'inscription conservee pour detecter la reouverture d'essais
/// (Addendum §38). Les signaux techniques sont HASHES : on conserve la
/// capacite de comparer sans stocker l'IP ni l'empreinte en clair.
model TrialRegistration {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @unique @map("tenant_id") @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  /// Numero verifie par OTP : identifiant fort, unique par essai.
  verifiedPhoneE164 String?            @map("verified_phone_e164")
  emailNormalized   String             @map("email_normalized")
  ipHash            String?            @map("ip_hash")
  deviceFingerprintHash String?        @map("device_fingerprint_hash")
  signals           String[]           @default([])
  score             Int                @default(0)
  decision          TrialAbuseDecision @default(ALLOW)
  reviewedByUserId  String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNote        String?            @map("review_note")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Un numero verifie ne peut ouvrir qu'un seul essai.
  @@unique([verifiedPhoneE164])
  @@index([emailNormalized])
  @@index([ipHash, createdAt])
  @@index([deviceFingerprintHash, createdAt])
  @@index([decision, createdAt])
  @@map("trial_registrations")
}

// ============================================================================
// NOTIFICATIONS, AUDIT, OBSERVABILITE
// ============================================================================

model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  /// Destinataire ; null = notification de boutique, visible par tous les
  /// membres disposant de la permission correspondante.
  membershipId String?           @map("membership_id") @db.Uuid
  type      String
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String
  /// Lien profond vers la ressource concernee.
  resourceType String?           @map("resource_type")
  resourceId   String?           @map("resource_id") @db.Uuid
  metadata  Json?
  readAt    DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([tenantId, membershipId, readAt, createdAt])
  @@index([tenantId, type, createdAt])
  @@map("notifications")
}

/// Tentative d'acheminement sur un canal donne (Addendum §36).
/// Separee de `Notification` pour decoupler le metier du transport.
model NotificationDelivery {
  id             String                     @id @default(uuid(7)) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  target         String?
  attempt        Int                        @default(0)
  errorMessage   String?                    @map("error_message")
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  membershipId String?             @map("membership_id") @db.Uuid
  type         String
  channel      NotificationChannel
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, membershipId, type, channel])
  @@map("notification_preferences")
}

/// Journal d'audit des operations sensibles (V2 §23).
/// Append-only : aucune mise a jour ni suppression n'est exposee par l'API.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorKind  ActorKind @default(USER) @map("actor_kind")
  /// Libelle d'acteur fige : l'audit reste lisible meme apres anonymisation.
  actorLabel String?  @map("actor_label")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Metadonnees NON SENSIBLES uniquement. Le service d'audit applique une
  /// liste blanche de champs (jamais de mot de passe, token ou secret).
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  correlationId String? @map("correlation_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Incident technique expose au centre d'incidents (V2 §21).
model Incident {
  id          String               @id @default(uuid(7)) @db.Uuid
  tenantId    String?              @map("tenant_id") @db.Uuid
  code        String
  severity    NotificationSeverity @default(ERROR)
  title       String
  detail      String?
  /// Contexte technique expurge de tout secret.
  context     Json?
  resolvedAt  DateTime?            @map("resolved_at") @db.Timestamptz(3)
  occurrences Int                  @default(1)
  firstSeenAt DateTime             @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt, lastSeenAt])
  @@index([code, lastSeenAt])
  @@map("incidents")
}

/// Boite d'envoi transactionnelle : un evenement metier est ecrit dans la MEME
/// transaction que le changement d'etat, puis publie de facon asynchrone.
/// Garantit qu'une notification n'est jamais perdue ni envoyee pour une
/// transaction annulee.
model OutboxEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String?      @map("tenant_id") @db.Uuid
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?      @map("last_error")
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([tenantId, eventType, createdAt])
  @@map("outbox_events")
}
