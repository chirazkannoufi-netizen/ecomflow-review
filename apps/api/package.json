{
  "name": "@ecomflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "API EcomFlow — NestJS, PostgreSQL, Redis",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build -w @ecomflow/shared && nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "start:dev": "npm run build -w @ecomflow/shared && dotenv -e ../../.env -- nest start --watch",
    "start:debug": "dotenv -e ../../.env -- nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test": "npm run test:unit",
    "test:unit": "jest --config test/jest-unit.config.js",
    "test:integration": "dotenv -e ../../.env -- jest --config test/jest-integration.config.js --runInBand",
    "test:e2e": "dotenv -e ../../.env -- jest --config test/jest-e2e.config.js --runInBand",
    "test:cov": "jest --config test/jest-unit.config.js --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "prisma:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "seed": "dotenv -e ../../.env -- ts-node -r tsconfig-paths/register prisma/seed.ts",
    "seed:demo": "dotenv -e ../../.env -- ts-node -r tsconfig-paths/register prisma/seed.ts --with-demo",
    "seed:queue": "dotenv -e ../../.env -- ts-node -r tsconfig-paths/register prisma/seed-confirmation-queue.ts",
    "openapi:export": "dotenv -e ../../.env -- ts-node -r tsconfig-paths/register scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@ecomflow/shared": "0.1.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/schedule": "6.0.0",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@node-rs/argon2": "2.2.0",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "bullmq": "5.81.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "googleapis": "144.0.0",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "nestjs-pino": "4.4.0",
    "nodemailer": "^6.9.16",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.17.1",
    "pino": "9.7.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "2.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.8",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.13.9",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "11.0.0",
    "embedded-postgres": "^17.4.0-beta.15",
    "jest": "29.7.0",
    "jest-mock-extended": "3.0.7",
    "pino-pretty": "13.0.0",
    "supertest": "7.1.1",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
