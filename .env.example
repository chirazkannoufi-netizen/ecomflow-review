###############################################################################
# EcomFlow — Modele de configuration
#
# Copiez ce fichier vers `.env` puis renseignez les valeurs reelles.
#   cp .env.example .env
#
# CE FICHIER NE DOIT JAMAIS CONTENIR DE VRAIE VALEUR SENSIBLE.
# Le fichier `.env` est ignore par Git (.gitignore) et ne doit jamais etre
# commite, ni partage par messagerie.
#
# Generer un secret :        openssl rand -hex 32
# Generer une cle AES-256 :  openssl rand -base64 32
###############################################################################

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1

# URL publique du frontend (liens des e-mails, redirections OAuth)
APP_URL=http://localhost:3000
# URL publique de l'API (callbacks OAuth, webhooks transporteurs et paiement)
API_URL=http://localhost:3001

# Origines autorisees par CORS, separees par des virgules
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
# Doit imperativement valoir false en production
SWAGGER_ENABLED=true

# =============================================================================
# BASE DE DONNEES
# =============================================================================
DATABASE_URL=postgresql://ecomflow:CHANGE_ME@localhost:5432/ecomflow?schema=public
DATABASE_POOL_SIZE=10

# =============================================================================
# REDIS / FILES D'ATTENTE
# Requis en production. En developpement, laisser vide fait basculer les
# traitements asynchrones en execution synchrone (voir README, section Jobs).
# =============================================================================
REDIS_URL=redis://localhost:6379
QUEUE_WORKERS_ENABLED=true

# =============================================================================
# AUTHENTIFICATION
# Les deux secrets JWT doivent etre DIFFERENTS (verifie au demarrage).
# =============================================================================
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_openssl_rand_hex_32_at_least_32
JWT_REFRESH_TTL=30d
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_DURATION_MINUTES=15

# =============================================================================
# CHIFFREMENT AU REPOS
# ENCRYPTION_KEY protege les tokens OAuth Google et les cles d'API transporteurs
# stockes en base. Sa perte rend ces integrations irrecuperables : sauvegardez-la
# dans votre gestionnaire de secrets, jamais dans le depot.
# =============================================================================
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32_exactly_32_bytes=
HASH_PEPPER=CHANGE_ME_openssl_rand_hex_32_at_least_32_chars

# =============================================================================
# LIMITATION DE DEBIT
# =============================================================================
# Mettre a false uniquement si une couche amont (passerelle API, CDN) applique
# deja une limitation de debit. Sinon, laisser true.
THROTTLE_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# =============================================================================
# GOOGLE SHEETS (V2 §12)
# Console Google Cloud > API et services > Identifiants > ID client OAuth 2.0
# Scope requis : https://www.googleapis.com/auth/spreadsheets.readonly
# (ajouter .../spreadsheets si l'ecriture du statut en retour est activee)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google/callback
GOOGLE_SHEETS_MAX_ROWS_PER_RUN=500
GOOGLE_SHEETS_RATE_LIMIT_PER_MINUTE=50

# =============================================================================
# WHATSAPP BUSINESS CLOUD (Addendum §31)
# Laisser WHATSAPP_ENABLED=false tant que le compte Meta Business n'est pas
# valide : le filtre automatique est alors inactif et toutes les commandes
# partent directement en file d'appel humaine.
# =============================================================================
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# =============================================================================
# CHARGILY PAY (Addendum §35)
# Laisser CHARGILY_ENABLED=false active uniquement le paiement manuel
# (virement / BaridiMob avec validation par le Super Admin).
# =============================================================================
CHARGILY_ENABLED=false
CHARGILY_BASE_URL=https://pay.chargily.net/api/v2
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=

# =============================================================================
# MESSAGERIE
# MAIL_DRIVER=console ecrit les e-mails dans les logs (developpement).
# =============================================================================
MAIL_DRIVER=console
MAIL_FROM=EcomFlow <no-reply@ecomflow.dz>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# =============================================================================
# OTP (verification du numero — prevention de l'abus du Trial, Addendum §38)
# OTP_DRIVER=console affiche le code dans les logs (developpement uniquement).
# =============================================================================
OTP_DRIVER=console
OTP_TTL_MINUTES=10

# =============================================================================
# STOCKAGE DE FICHIERS (justificatifs de paiement, exports, images produits)
# =============================================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# =============================================================================
# AMORCAGE (seed)
# Compte Super Admin cree au premier `npm run seed`. Changez le mot de passe
# des la premiere connexion.
# =============================================================================
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# =============================================================================
# CONSERVATION DES DONNEES (loi 18-07, Addendum §37)
# =============================================================================
DATA_RETENTION_DAYS_AFTER_EXPIRY=90
AUDIT_RETENTION_DAYS=730

# =============================================================================
# FRONTEND (apps/web) — prefixe NEXT_PUBLIC_ = expose au navigateur.
# N'y placez JAMAIS de secret.
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=EcomFlow
